---
// Sticky top nav. Lives in the Layout so every page gets it.
// Links use "/#id" so they also work from case-study pages.
const links = [
  { label: "Work", href: "/#work" },
  { label: "About", href: "/#about" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/70 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-6">
    <a
      href="/"
      class="font-medium text-ink transition-opacity hover:opacity-80"
    >
      Anesu Ruzvidzo
    </a>
    <ul class="flex items-center gap-6 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
