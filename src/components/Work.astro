---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";

// Featured projects lead the first row; the rest follow in their listed order.
const ordered = [...projects].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false),
);

// Filter order: capability lanes first, then the cross-cutting Energy spear.
const filters = [
  "All",
  "LLM & Agents",
  "ML & Data",
  "Optimization",
  "Full-Stack",
  "Energy",
];
---

<section id="work" class="mx-auto max-w-5xl scroll-mt-16 px-6 py-24">
  <header class="mb-8 flex flex-col gap-3">
    <p class="font-mono text-xs uppercase tracking-wide text-accent">
      Selected work
    </p>
    <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      From problem to production
    </h2>
    <p class="max-w-xl text-muted">
      Every one is live and open source. Click through to try it or read the code.
    </p>
  </header>

  <!-- Filter bar -->
  <div
    role="group"
    aria-label="Filter projects by area"
    class="mb-8 flex flex-wrap gap-2"
  >
    {
      filters.map((filter, i) => (
        <button
          type="button"
          data-filter={filter}
          aria-pressed={i === 0 ? "true" : "false"}
          class:list={[
            "rounded-full px-3.5 py-1.5 font-mono text-xs transition-colors",
            i === 0
              ? "bg-accent text-accent-ink"
              : "border border-line text-muted hover:text-ink",
          ]}
        >
          {filter}
        </button>
      ))
    }
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {ordered.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>(".project-card");

  function setFilter(value: string) {
    cards.forEach((card) => {
      const capability = card.dataset.capability;
      const isEnergy = card.dataset.energy === "true";
      const show =
        value === "All" ||
        capability === value ||
        (value === "Energy" && isEnergy);
      card.classList.toggle("hidden", !show);
    });

    buttons.forEach((btn) => {
      const active = btn.dataset.filter === value;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("bg-accent", active);
      btn.classList.toggle("text-accent-ink", active);
      btn.classList.toggle("border", !active);
      btn.classList.toggle("border-line", !active);
      btn.classList.toggle("text-muted", !active);
    });
  }

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => setFilter(btn.dataset.filter!)),
  );
</script>
