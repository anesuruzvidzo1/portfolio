---
// The hero: first thing a visitor sees. Name, positioning, value, and CTAs.
import { Image } from "astro:assets";
import headshot from "../assets/headshot.jpg";

const github = "https://github.com/anesuruzvidzo1";
---

<section class="mx-auto grid max-w-5xl items-center gap-12 px-6 py-20 md:min-h-[86vh] md:grid-cols-[1.4fr_1fr] md:gap-16 md:py-0">
  <!-- Left: text -->
  <div class="flex flex-col items-start gap-6">
    <!-- Availability pill -->
    <span class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      Open to roles · US &amp; Canada
    </span>

    <div class="flex flex-col gap-3">
      <h1 class="text-5xl font-semibold tracking-tight text-ink sm:text-6xl">
        Anesu Ruzvidzo
      </h1>
      <p class="text-xl text-accent sm:text-2xl">
        Full-Stack &amp; AI Engineer
      </p>
    </div>

    <p class="max-w-xl text-lg leading-relaxed text-muted">
      I'm a full-stack engineer who ships production AI and ML end to end, from
      the data and model layer to the interface people actually use. I go deep in
      the domain I'm building for and take most of it from idea to deployment on
      my own.
    </p>

    <div class="mt-2 flex flex-wrap items-center gap-3">
      <a
        href="#work"
        class="rounded-lg bg-accent px-5 py-2.5 font-medium text-accent-ink transition-opacity hover:opacity-90"
      >
        View work
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-line px-5 py-2.5 font-medium text-ink transition-colors hover:bg-surface-hover"
      >
        GitHub
      </a>
    </div>
  </div>

  <!-- Right: headshot -->
  <div>
    <div class="mx-auto aspect-[4/5] w-48 overflow-hidden rounded-2xl border border-line bg-surface md:w-full md:max-w-[20rem]">
      <Image
        src={headshot}
        alt="Anesu Ruzvidzo"
        width={640}
        class="h-full w-full object-cover object-top"
      />
    </div>
  </div>
</section>
